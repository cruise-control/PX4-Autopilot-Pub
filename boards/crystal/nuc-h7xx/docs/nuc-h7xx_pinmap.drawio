        <mxCell id="mnote" value="All signals reach the ST Zio connectors (CN7–CN10): A0–A5/D0–D15 are the Arduino subset of Zio; PB10/PB11 (PWM7/8) and PD0/PD1 (CAN) are Zio-extension pins. CAN needs an external transceiver (Nucleo has none)." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=10;fontColor=#555555;fillColor=#e8f0fe;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="279" width="240" height="110" as="geometry" /></mxCell>

        <!-- ===================== On-board / fixed pins note ===================== -->
        <mxCell id="sysHdr" value="On-board / fixed function pins (not on the external HAT headers)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;fontColor=#ffffff;fontStyle=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="900" height="28" as="geometry" /></mxCell>
        <mxCell id="sys" value="LEDs: PB0 (green) · PE1 (yellow) · PB14 (red)        USB OTG-FS: PA9 (VBUS) · PA11 (DM) · PA12 (DP)        Console USART3 (ST-LINK VCP): PD8 (TX) · PD9 (RX)        HSE clock: PH0 / PH1 (8 MHz from ST-LINK MCO)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#fafafa;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="458" width="900" height="56" as="geometry" /></mxCell>

        <!-- ===================== PWM/DShot footnote ===================== -->
        <mxCell id="foot" value="PWM groups → IO timers: TIM1 = outputs 1–4 (DShot-capable, default DShot300), TIM4 = outputs 5–6, TIM2 = outputs 7–8.  Display SPI is SPI1; CS is software-driven on PD14.  All EC11 inputs are pull-up + EXTI on distinct EXTI lines." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=10;fontColor=#444444;fillColor=#ffffff;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="900" height="46" as="geometry" /></mxCell>

