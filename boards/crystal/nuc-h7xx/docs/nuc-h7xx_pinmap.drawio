        <mxCell id="sysHdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;fontColor=#ffffff;fontStyle=1;align=center;fontSize=12;" value="On-board / fixed function pins (not on the external HAT headers)" vertex="1">
          <mxGeometry height="28" width="1350" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="sys" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#fafafa;strokeColor=#bbbbbb;" value="LEDs: PB0 (green) · PE1 (yellow) · PB14 (red)        USB OTG-FS: PA9 (VBUS) · PA11 (DM) · PA12 (DP)        Console USART3 (ST-LINK VCP): PD8 (TX) · PD9 (RX) = /dev/ttyS1 / TEL1        HSE clock: PH0 / PH1 (8 MHz from ST-LINK MCO)" vertex="1">
          <mxGeometry height="40" width="1350" x="40" y="448" as="geometry" />
        </mxCell>
        <mxCell id="foot" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=10;fontColor=#444444;fillColor=#e8f0fe;strokeColor=#6c8ebf;" value="All signals route to the ST Zio connectors (CN7–CN10), a superset of Arduino R3. UART roles: USART2 = /dev/ttyS0 (GPS1), USART3 = /dev/ttyS1 (TEL1, VCP console), USART6 = /dev/ttyS2 (TEL2) — ttyS index is sequential among enabled USARTs. SPI4/SPI5 CS pins (PE4/PG1, dashed) are board defaults — set per device. FDCAN1 needs an external transceiver (Nucleo has none)." vertex="1">
          <mxGeometry height="48" width="1350" x="40" y="496" as="geometry" />
        </mxCell>
        <mxCell id="foot2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=10;fontColor=#444444;fillColor=#ffffff;strokeColor=#dddddd;" value="PWM groups → IO timers: TIM1 = outputs 1–4 (DShot-capable, default DShot300), TIM4 = outputs 5–6, TIM2 = outputs 7–8.  Display SPI is SPI1 (CS software-driven on PD14).  EC11 inputs are pull-up + EXTI on distinct EXTI lines." vertex="1">
          <mxGeometry height="40" width="1350" x="40" y="552" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
