        <mxCell id="note1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=10;fillColor=#e8f0fe;strokeColor=#6c8ebf;" value="Buses by connector (UM2407 / MB1364):  CN7 = SPI1 (PA5/PA6/PB5), display CS/DC/RES (PD14/PD15/PF3), I2C1 (PB8/PB9), USART6 (PC6/PC7).  CN9 = encoder (PA3/PC0/PB1/PC2), I2C2 (PF1/PF0), CAN1 (PD0 RX / PD1 TX), USART2 (PD5/PD6), SPI4 (PE2/PE5/PE6, CS PE4), SPI5 (PF7/PF8/PF9, CS PG1).  CN10 = PWM1-8 (PE9/PE11/PE13/PE14, PB6/PB7, PB10/PB11), display BLK (PG12), I2C4 (PD12/PD13).  CN8 = power + SDMMC (no driver signals)." vertex="1">
          <mxGeometry height="210" width="390" x="910" y="72" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=10;fillColor=#fde7e9;strokeColor=#b85450;" value="Shared pins (* = use one position):  PE2 SPI4-SCK on CN9-14 AND CN10-25 (we use CN9-14).  PE6 SPI4-MOSI on CN9-20 AND CN10-28 (we use CN9-20).  PE9 PWM1 on CN10-4 (used) AND CN9-15.  I2C1 PB8/PB9 default to CN7 D15/D14; CN9 A4/A5 are solder-bridge alternates (encoder keeps PC2 at A4)." vertex="1">
          <mxGeometry height="170" width="390" x="910" y="292" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="text;html=1;align=left;fontSize=9;fontColor=#555555;" value="Colors: orange=encoder  green=I2C  purple=PWM  blue=display-ctrl  deep-blue=SPI bus  teal=UART  red=CAN  yellow=SDMMC  grey=power/GND  light=free" vertex="1">
          <mxGeometry height="16" width="1260" x="30" y="476" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
