#!/bin/sh
#
# Crystal NUC-H7xx (Nucleo-H753ZI) board-specific defaults
#------------------------------------------------------------------------------
# USART3 (ST-LINK VCP, /dev/ttyS2) is the NuttX system console.
# USB CDC-ACM (/dev/ttyACM0) is started by SYSTEM_CDCACM and carries MAVLink.

# Turn off the Telemetry for dshot
param set-default DSHOT_TEL_CFG 0

# Run the TIM1 output group (outputs 1-4, PE9/PE11/PE13/PE14) as DShot300.
# Requires the per-timer burst DMA configured in src/timer_config.cpp.
# Set PWM_MAIN_TIM1 (TIM4, outputs 5-6) / PWM_MAIN_TIM2 (TIM2, outputs 7-8)
# the same way to run those groups as DShot too; they stay PWM by default.
param set-default PWM_MAIN_TIM0 -4

# EC11 rotary encoder pin map (STM32 GPIO config words, see src/board_config.h)
# All on the Arduino analog header; distinct pin numbers -> distinct EXTI lines.
#   A=A0/PA3  B=A1/PC0  PUSH=A3/PB1  K0=A4/PC2  (input, pull-up, EXTI)
param set-default EC11_GPIO_PIN_A 65795   # A0/PA3  0x00010103 (EXTI3)
param set-default EC11_GPIO_PIN_B 65824   # A1/PC0  0x00010120 (EXTI0)
param set-default EC11_GPIO_PUSH  65809   # A3/PB1  0x00010111 (EXTI1)
param set-default EC11_GPIO_K0    65826   # A4/PC2  0x00010122 (EXTI2)

# EC11 rotary encoder — start only when phase-A GPIO has been configured.
if param greater EC11_GPIO_PIN_A 0
then
    ec11_rotary_encoder start
fi

# ST7789 SPI display pin map (STM32 GPIO config words, see src/board_config.h)
# All on the Arduino digital header.
#   SPI1 (SCK PA5/D13, MISO PA6/D12, MOSI PB5/D11), CS=D10, DC=D9, RES=D8, BLK=D7
param set-default ST7789_GPIO_CS  264510  # D10/PD14 0x0004093E (output, idle high)
param set-default ST7789_GPIO_DC  264255  # D9/PD15  0x0004083F
param set-default ST7789_GPIO_RES 264275  # D8/PF3   0x00040853
param set-default ST7789_GPIO_BLK 264300  # D7/PG12  0x0004086C

# ST7789 SPI display — start only when DC GPIO has been configured.
if param greater ST7789_GPIO_DC 0
then
    st7789_display start
fi
