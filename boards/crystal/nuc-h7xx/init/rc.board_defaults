#!/bin/sh
#
# Crystal NUC-H7xx (Nucleo-H753ZI) board-specific defaults
#------------------------------------------------------------------------------
# USART3 (ST-LINK VCP, /dev/ttyS1) is the NuttX system console.
# USB CDC-ACM (/dev/ttyACM0) is started by SYSTEM_CDCACM and carries MAVLink.


# NODE_ID (1) and BITRATE (1 Mbit/s) keep their sane param defaults.
param set-default UAVCAN_ENABLE 3

# DShot ESC telemetry serial input is wired to USART6 RX (PC7) = TELEM2 = /dev/ttyS2.
# 102 = TELEM 2. After 'dshot start', the auto-generated rc.serial (sourced by rcS)
# runs "dshot telemetry -d /dev/ttyS2", so ESC telemetry starts on boot.
param set-default DSHOT_TEL_CFG 102

param set PWM_MAIN_FUNC1 101
param set PWM_MAIN_FUNC2 102
param set PWM_MAIN_FUNC3 103
param set PWM_MAIN_FUNC4 104
param set PWM_MAIN_FUNC5 105
param set PWM_MAIN_FUNC6 106
param set PWM_MAIN_FUNC7 107
param set PWM_MAIN_FUNC8 108

param set UAVCAN_EC_FUNC1 101
param set UAVCAN_EC_FUNC2 102
param set UAVCAN_EC_FUNC3 103
param set UAVCAN_EC_FUNC4 104
param set UAVCAN_EC_FUNC5 105
param set UAVCAN_EC_FUNC6 106
param set UAVCAN_EC_FUNC7 107
param set UAVCAN_EC_FUNC8 108


# Run all three timer groups as standard 50 Hz PWM (20 ms period).
# PWM_MAIN_TIM value is the output frequency in Hz; positive = PWM, negative = DShot.
param set-default PWM_MAIN_TIM0 50
param set-default PWM_MAIN_TIM1 50
param set-default PWM_MAIN_TIM2 50

# Standard PWM pulse widths in microseconds, tuned to AM32 default thresholds:
#   servo_low_threshold  = 1100 µs — below this AM32 outputs zero (no thrust)
#   servo_high_threshold = 1900 µs — above this AM32 saturates at maximum
# MIN matches the low threshold so the FC's zero-throttle maps to the actual
# spin-up point. DIS/FAIL sit 100 µs below that threshold so the ESC reads
# zero and will not arm.
param set-default PWM_MAIN_MIN1 1100
param set-default PWM_MAIN_MIN2 1100
param set-default PWM_MAIN_MIN3 1100
param set-default PWM_MAIN_MIN4 1100
param set-default PWM_MAIN_MIN5 1100
param set-default PWM_MAIN_MIN6 1100
param set-default PWM_MAIN_MIN7 1100
param set-default PWM_MAIN_MIN8 1100

param set-default PWM_MAIN_MAX1 1900
param set-default PWM_MAIN_MAX2 1900
param set-default PWM_MAIN_MAX3 1900
param set-default PWM_MAIN_MAX4 1900
param set-default PWM_MAIN_MAX5 1900
param set-default PWM_MAIN_MAX6 1900
param set-default PWM_MAIN_MAX7 1900
param set-default PWM_MAIN_MAX8 1900

param set-default PWM_MAIN_DIS1 1000
param set-default PWM_MAIN_DIS2 1000
param set-default PWM_MAIN_DIS3 1000
param set-default PWM_MAIN_DIS4 1000
param set-default PWM_MAIN_DIS5 1000
param set-default PWM_MAIN_DIS6 1000
param set-default PWM_MAIN_DIS7 1000
param set-default PWM_MAIN_DIS8 1000

param set-default PWM_MAIN_FAIL1 1000
param set-default PWM_MAIN_FAIL2 1000
param set-default PWM_MAIN_FAIL3 1000
param set-default PWM_MAIN_FAIL4 1000
param set-default PWM_MAIN_FAIL5 1000
param set-default PWM_MAIN_FAIL6 1000
param set-default PWM_MAIN_FAIL7 1000
param set-default PWM_MAIN_FAIL8 1000

# Bidirectional DShot — eRPM feedback over the signal wire (no extra serial wire).
# The board already supports this: timer_config.cpp gives TIM1 a DMA1 stream, which
# initIOTimer populates as BOTH the burst (dma_map_up) and the per-channel capture
# (dma_map_ch[0..3]) maps the H7 bdshot driver needs (DMA2 is the display SPI, so no
# contention). The ESC must also have bidirectional DShot enabled (AM32/BLHeli32).
#
# LIMITATION: the H7 driver hardcodes bidir to ONE timer group (index 0 = TIM1,
# outputs 1-4). With bidir on, outputs 5-8 (TIM4/TIM2) are NOT driven — only 1-4
# work. Fine for the servo_test bench (motor 1 = output 1). Reboot required.
param set-default DSHOT_BIDIR_EN 0

# Motor magnetic pole count — converts captured eRPM to mechanical RPM
# (rpm = erpm / (poles/2)). HGLRC SPECTER 1303.5 5500KV is 9N12P → 12 poles.
param set-default MOT_POLE_COUNT 12

# EC11 rotary encoder pin map (STM32 GPIO config words, see src/board_config.h)
# All on the Arduino analog header; distinct pin numbers -> distinct EXTI lines.
#   A=A0/PA3  B=A1/PC0  PUSH=A3/PB1  K0=A4/PC2  (input, pull-up, EXTI)
param set-default EC11_GPIO_PIN_A 65795   # A0/PA3  0x00010103 (EXTI3)
param set-default EC11_GPIO_PIN_B 65824   # A1/PC0  0x00010120 (EXTI0)
param set-default EC11_GPIO_PUSH  65809   # A3/PB1  0x00010111 (EXTI1)
param set-default EC11_GPIO_K0    65826   # A4/PC2  0x00010122 (EXTI2)

# EC11 rotary encoder — start only when phase-A GPIO has been configured.
if param greater EC11_GPIO_PIN_A 0
then
    ec11_rotary_encoder start
fi

# ST7789 SPI display pin map (STM32 GPIO config words, see src/board_config.h)
# All on the Arduino digital header.
#   SPI1 (SCK PA5/D13, MISO PA6/D12, MOSI PB5/D11), CS=D10, DC=D9, RES=D8, BLK=D7
param set-default ST7789_GPIO_CS  264510  # D10/PD14 0x0004093E (output, idle high)
param set-default ST7789_GPIO_DC  264255  # D9/PD15  0x0004083F
param set-default ST7789_GPIO_RES 264275  # D8/PF3   0x00040853
param set-default ST7789_GPIO_BLK 264300  # D7/PG12  0x0004086C
param set-default ST7789_ROTATE   1        # 1 = landscape (320x240)

# ST7789 SPI display — start only when DC GPIO has been configured.
if param greater ST7789_GPIO_DC 0
then
    st7789_display start
fi

# INA238 I2C power monitor — supply voltage + current to the DUT.
# Bus and address depend on the HAT hardware; confirm from schematic.
#   Default address: 0x45 (A0=VCC); use 0x40 if A0=GND.
#   -X = external I2C, -b = bus number (1 = I2C1/Arduino header), -k = keep running if unplugged.
ina238 start -X -b 1 -a 0x45 -k

# servo_test group protocol defaults (set before servo_test starts).
#   SVT_GRP_A_MODE: Group A (ch1-4/TIM1) — 2=DShot300, 0=disabled
#   SVT_GRP_B/C_MODE: Groups B/C — 0=disabled by default
param set-default SVT_THR_STEP   0.000625
param set-default SVT_GRP_A_MODE 2
param set-default SVT_GRP_B_MODE 0
param set-default SVT_GRP_C_MODE 0
param set-default SVT_UAVCAN_EN  0
param set-default SVT_RAMP_EN    1
param set-default SVT_RAMP_TAU   0.5

# servo_test — multi-protocol bench ESC/motor test UI.
# State machine: CONFIG (hold K0 2s for setup) -> RUNNING (PUSH) -> CONFIG.
# Drives motors via actuator_test topic (works while disarmed).
servo_test start
